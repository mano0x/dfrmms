# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git - never commit real values.

# Public (safe in the browser): where the Appwrite project lives.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=

# SECRET (server only): Appwrite Console > Overview > API keys.
# Scopes needed: databases, tables, columns, indexes, rows (read+write),
# buckets and files (read+write), users (read+write).
# Never give this a NEXT_PUBLIC_ name and never paste it into chat or code.
APPWRITE_API_KEY=

# Optional (server only, not secret): how long a free-item reservation lasts,
# in hours (1 to 168). Leave empty for the default of 24.
FREE_RESERVATION_HOURS=

# SECRET (server only): key for the keyed hash of network addresses in the
# security event log and the limits. Any random text of at least 32
# characters. Changing it makes older hashes impossible to compare with new
# ones. Never give it a NEXT_PUBLIC_ name.
SECURITY_HASH_KEY=

# SECRET (server only): key or keys for encrypting sensitive fields.
# Form: <id>:<base64 of 32 random bytes>, several separated by commas; the
# first one encrypts new values, the others still decrypt older values.
# Losing a key makes the values encrypted with it unreadable for good.
DATA_ENCRYPTION_KEY=

# SECRET (server only): protects the daily job (/api/jobs/daily). Vercel sends
# it as "Authorization: Bearer <value>" when it calls the job. At least 16
# characters, letters and digits only. In Vercel, a changed value takes
# effect with the next deployment.
CRON_SECRET=

# The three secrets above can be made and written here without ever being
# shown:  npm run secrets:add

# SECRET, only needed to run the API tests (npm run test:api): the password
# shared by the test accounts that npm run appwrite:test-users creates.
TEST_USER_PASSWORD=

# A separate Appwrite project for tests uses the same names in a second file,
# .env.test.local, read by the tp:* commands (see README).
