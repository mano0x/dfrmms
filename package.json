{
  "name": "dfrmms",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit",
    "appwrite:setup": "node --env-file=.env.local scripts/appwrite-setup.mjs",
    "appwrite:check": "node --env-file=.env.local scripts/appwrite-setup.mjs --check",
    "appwrite:verify": "node --env-file=.env.local scripts/appwrite-verify.mjs",
    "appwrite:test-users": "node --env-file=.env.local scripts/appwrite-test-users.mjs",
    "reference:dry": "node --env-file=.env.local scripts/reference-migrate.mjs",
    "reference:run": "node --env-file=.env.local scripts/reference-migrate.mjs --run",
    "test:api": "node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/api --testTimeout=60000 --no-file-parallelism --hookTimeout=120000",
    "tp:check": "node --env-file=.env.test.local scripts/appwrite-setup.mjs --check",
    "tp:setup": "node --env-file=.env.test.local scripts/appwrite-setup.mjs",
    "tp:verify": "node --env-file=.env.test.local scripts/appwrite-verify.mjs",
    "tp:test-users": "node --env-file=.env.test.local scripts/appwrite-test-users.mjs",
    "tp:test-api": "node --env-file=.env.test.local node_modules/vitest/vitest.mjs run tests/api --testTimeout=60000 --no-file-parallelism --hookTimeout=120000",
    "secrets:add": "node scripts/add-secrets.mjs",
    "key:set": "node scripts/set-api-key.mjs",
    "password:set": "node --env-file=.env.local scripts/set-password.mjs",
    "accounts:check": "node scripts/accounts-signin-check.mjs",
    "names:sync-dry": "node --env-file=.env.local scripts/sync-stored-names.mjs",
    "names:sync-run": "node --env-file=.env.local scripts/sync-stored-names.mjs --run"
  },
  "dependencies": {
    "next": "16.4.6",
    "node-appwrite": "^31.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
